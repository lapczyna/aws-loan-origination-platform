<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.los</groupId>
    <artifactId>loan-origination-platform</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>test-support</artifactId>
  <name>Shared :: Test Support</name>
  <description>
    Shared test infrastructure: Testcontainers definitions for PostgreSQL, Kafka
    and LocalStack, an ephemeral JWT issuer for OAuth2 resource-server tests, a
    log-capturing appender used to prove that sensitive markers never reach the
    logging pipeline, and synthetic data builders.

    Every value produced by this module is synthetic. It contains no real
    credentials, no real personal data and no production configuration.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>compile</scope>
    </dependency>

    <!--
      Testcontainers 2.x renamed every module: the artifacts are
      testcontainers-<module>, not <module> (the old coordinates stop at 1.21.x).
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-localstack</artifactId>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>compile</scope>
    </dependency>

    <!-- Ephemeral RS256 key pairs and signed test tokens; no key is ever committed. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
      <scope>compile</scope>
    </dependency>

    <!--
      Serves the OIDC discovery document and JWKS for the ephemeral test issuer,
      so integration tests exercise the real JwtDecoder including issuer and
      audience validation rather than replacing it with a stub.
      The shaded standalone build is used to keep WireMock's Jetty off the
      classpath, where it would collide with the Jetty that Spring Boot manages.
    -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <scope>compile</scope>
    </dependency>

    <!-- Log capture for the sensitive-marker assertions. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>compile</scope>
    </dependency>
  </dependencies>
</project>
