# ---------------------------------------------------------------------------
# Example environment file for LOCAL DEVELOPMENT ONLY.
#
# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# Every value below is a placeholder or a synthetic local-only credential. None
# of them is used outside a developer's Docker Compose stack. Production
# configuration comes from AWS Secrets Manager, mounted as files by the Secrets
# Store CSI driver and read through a Spring config tree; it is never supplied
# through environment variables and never lives in a file like this one.
# ---------------------------------------------------------------------------

# --- Local PostgreSQL (Docker Compose only) --------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=los
# Synthetic local-only credentials. Not a secret; not used anywhere but Compose.
POSTGRES_USER=los_local
POSTGRES_PASSWORD=change-me-local-only

# --- Local Kafka (KRaft, no authentication) --------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# --- LocalStack (S3 and Secrets Manager simulation) ------------------------
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=eu-west-1
# LocalStack accepts any credentials; these are the conventional dummy values
# and grant access to nothing outside the local container.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

DOCUMENTS_BUCKET=los-local-documents
AUDIT_BUCKET=los-local-audit

# --- OAuth2 resource server ------------------------------------------------
# Placeholder issuer. Replace with your own identity provider.
# Do NOT commit a real Cognito user-pool URL, tenant identifier or audience.
OAUTH2_ISSUER_URI=https://issuer.example.com/realms/los-local
OAUTH2_AUDIENCE=los-local-api

# --- Applicant pseudonymisation pepper -------------------------------------
# In AWS this is a Secrets Manager secret. The local value is generated into a
# gitignored file by scripts/generate-local-secrets.sh and read from there;
# this variable only points at that file.
APPLICANT_REFERENCE_PEPPER_FILE=./local-dev-keys/applicant-pepper

# --- Observability ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SPRING_PROFILES_ACTIVE=local
